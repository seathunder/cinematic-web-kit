{
  "name": "cinematic-web-toolkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local production toolkit for cinematic scroll-driven websites: kernel, templates, asset pipeline, CLI. Everything runs offline and free on one machine.",
  "workspaces": [
    "Projects/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cw": "node toolkit/scripts/cli.mjs",
    "doctor": "node toolkit/scripts/cli.mjs doctor",
    "new": "node toolkit/scripts/cli.mjs new",
    "assets": "node toolkit/scripts/cli.mjs assets",
    "check": "node toolkit/scripts/cli.mjs check"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "mp4box": "^2.4.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.185.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gh-pages": "^6.3.0",
    "gltfpack": "^1.2.0",
    "sharp": "^0.35.3",
    "stats-gl": "^4.2.3",
    "tweakpane": "^4.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-glsl": "^1.6.1"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "ffmpeg-static@5.3.0": true
  }
}
